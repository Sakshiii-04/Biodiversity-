        <mxCell id="flow_be_db_query" edge="1" parent="1" source="backend_boundary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#16A34A;fontColor=#15803D;" target="postgres_box" value="&lt;span style=&quot;background-color:#16A34A;color:#FFFFFF;padding:1px 5px;border-radius:3px;font-weight:bold;font-size:10.5px;&quot;&gt;STEP 2a&lt;/span&gt; &lt;b style=&quot;color:#15803D;font-size:11.5px;&quot;&gt;Slang &amp;amp; Law Query&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#166534;&quot;&gt;SELECT species &amp;amp; codewords&lt;/span&gt;">
