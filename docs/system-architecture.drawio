        <mxCell id="flow_fe_be" edge="1" parent="1" source="react_app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#2563EB;fontColor=#1D4ED8;" target="backend_boundary" value="&lt;span style=&quot;background-color:#2563EB;color:#FFFFFF;padding:1px 5px;border-radius:3px;font-weight:bold;font-size:10.5px;&quot;&gt;STEP 1&lt;/span&gt; &lt;b style=&quot;color:#2563EB;font-size:11.5px;&quot;&gt;POST /analyze&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#334155;&quot;&gt;ad text, image, or URL&lt;/span&gt;">
