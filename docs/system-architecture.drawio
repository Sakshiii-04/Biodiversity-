        <mxCell id="flow_crawl" edge="1" parent="1" source="ext_crawler" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#F43F5E;fontColor=#881337;" target="backend_boundary" value="&lt;span style=&quot;background-color:#BE123C;color:#FFFFFF;padding:1px 5px;border-radius:3px;font-weight:bold;font-size:10.5px;&quot;&gt;CRAWLER&lt;/span&gt; &lt;b style=&quot;color:#BE123C;font-size:11.5px;&quot;&gt;POST /ingest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#334155;&quot;&gt;discovered public listings&lt;/span&gt;">
          <mxGeometry relative="1" y="-20" as="geometry">
