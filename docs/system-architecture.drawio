  <diagram id="iwt-system-arch-v7" name="IWT Detection — System Architecture">
    <mxGraphModel dx="2037" dy="892" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="940" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#072533;strokeColor=#1FB6C9;strokeWidth=2;arcSize=4;" value="" vertex="1">
          <mxGeometry height="55" width="1600" x="30" y="15" as="geometry" />
        </mxCell>
        <mxCell id="banner_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size:19px;color:#9BF0FB;&quot;&gt;ILLEGAL WILDLIFE TRADE DETECTION SYSTEM&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="1600" x="30" y="18" as="geometry" />
        </mxCell>
        <mxCell id="banner_sub" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#CBD5E1;fontFamily=Helvetica;" value="Multimodal Machine Learning Architecture for Online Wildlife Trafficking Detection &amp;amp; Forensic Investigation" vertex="1">
          <mxGeometry height="22" width="1600" x="30" y="42" as="geometry" />
        </mxCell>
        <mxCell id="legend_bar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=1.5;fontSize=12.5;fontColor=#9A3412;" value="&lt;b&gt;Core Principle:&lt;/b&gt; &lt;span style=&quot;color:#EA580C;font-weight:800;&quot;&gt;ML models flag suspicious listings • Human officer verifies • No automated accusations • Public listing data only&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="1120" x="270" y="78" as="geometry" />
        </mxCell>
        <mxCell id="user_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;" value="&lt;b style=&quot;font-size:14.5px;color:#1E293B;&quot;&gt;Wildlife Crime Investigator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#64748B;&quot;&gt;Forest Departments • Enforcement • NGOs&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="250" x="40" y="125" as="geometry" />
        </mxCell>
        <mxCell id="react_app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;spacingTop=12;arcSize=6;" value="&lt;b style=&quot;font-size:17px;color:#1D4ED8;&quot;&gt;React Web Dashboard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#334155;font-weight:600;&quot;&gt;React 19 • TypeScript&lt;/span&gt;&lt;div style=&quot;text-align:left;font-size:11.5px;line-height:1.55;padding-left:4px;&quot;&gt;&lt;br&gt;&lt;b&gt;• Listing Submission:&lt;/b&gt; Input text, screenshot, or ad URL&lt;br&gt;&lt;b&gt;• Triage Queue:&lt;/b&gt; Review flagged listings by risk score&lt;br&gt;&lt;b&gt;• Evidence Dossier:&lt;/b&gt; Species ID, highlighted slang &amp;amp; law&lt;br&gt;&lt;b&gt;• Case Export:&lt;/b&gt; Standardized PDF/JSON case reports&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="250" x="40" y="215" as="geometry" />
        </mxCell>
        <mxCell id="backend_boundary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;verticalAlign=top;spacingTop=10;arcSize=4;" value="&lt;b style=&quot;font-size:18px;color:#0369A1;&quot;&gt;FastAPI Application Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569;&quot;&gt;Request Orchestration • Input Parsing • Pipeline Coordination&lt;/span&gt;" vertex="1">
          <mxGeometry height="365" width="680" x="440" y="125" as="geometry" />
        </mxCell>
        <mxCell id="engines_panel" parent="backend_boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;verticalAlign=top;spacingTop=8;arcSize=6;" value="&lt;b style=&quot;font-size:14.5px;color:#9A3412;&quot;&gt;CORE MACHINE LEARNING ENGINES PANEL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#7C2D12;&quot;&gt;Local Model Execution • Multimodal Analysis Pipeline&lt;/span&gt;" vertex="1">
          <mxGeometry height="285.6521739130435" width="650" x="15" y="58.18840579710145" as="geometry" />
        </mxCell>
        <mxCell id="engine_text" parent="engines_panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="&lt;b style=&quot;font-size: 13px; color: rgb(29, 78, 216);&quot;&gt;XLM-RoBERTa (Text Classifier)&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.55;&quot;&gt;&lt;b&gt;• Role:&lt;/b&gt; Scans listing text in Hindi, Hinglish &amp;amp; English for poacher codewords (e.g., &lt;i&gt;&quot;hathajodi&quot;&lt;/i&gt;)&lt;br&gt;&lt;b&gt;• Detection Focus:&lt;/b&gt; Flags covert selling language, permit evasion &amp;amp; bulk delivery offers&lt;br&gt;&lt;b&gt;• Output:&lt;/b&gt; Text suspicion score [0 to 1]&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="300" x="15" y="42" as="geometry" />
        </mxCell>
        <mxCell id="engine_image" parent="engines_panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="&lt;b style=&quot;font-size: 13px; color: rgb(91, 33, 182);&quot;&gt;CLIP (Image Classifier)&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.55;&quot;&gt;&lt;b&gt;• Role:&lt;/b&gt; Inspects photos to identify endangered species and contraband parts (scales, ivory, skins)&lt;br&gt;&lt;b&gt;• Detection Focus:&lt;/b&gt; Flags smuggling cues like concealed cages and shipping crates&lt;br&gt;&lt;b&gt;• Output:&lt;/b&gt; Image suspicion score [0 to 1]&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="300" x="335" y="42" as="geometry" />
        </mxCell>
        <mxCell id="engine_cites" parent="engines_panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;span style=&quot;background-color:#D97706;color:#FFFFFF;padding:1px 6px;border-radius:3px;font-weight:bold;font-size:11px;&quot;&gt;STEP 3&lt;/span&gt; &amp;nbsp;&lt;b style=&quot;font-size:12.5px;color:#92400E;&quot;&gt;Multimodal Fusion &amp;amp; Legal Grounding Layer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#78350F;line-height:1.5;&quot;&gt;&lt;b&gt;• Solution Role:&lt;/b&gt; Blends text and image scores with verified CITES &amp;amp; India WPA statutory tiers (retrieved in Step 2b) to generate the final calibrated risk verdict (&lt;i&gt;Suspected Trade / Requires Review / Cleared&lt;/i&gt;).&lt;/span&gt;" vertex="1">
          <mxGeometry height="72" width="620" x="15" y="195" as="geometry" />
        </mxCell>
        <mxCell id="ext_crawler" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;strokeWidth=2;verticalAlign=top;spacingTop=12;arcSize=6;" value="&lt;b style=&quot;font-size:17px;color:#881337;&quot;&gt;Automated Web Crawler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#BE123C;font-weight:bold;&quot;&gt;Playwright Headless Ingestion [Background]&lt;/span&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:11.5px;line-height:1.55;padding-left:4px;&quot;&gt;&lt;br&gt;&lt;b&gt;• Public Monitoring:&lt;/b&gt; Scans public classifieds and open social forums&lt;br&gt;&lt;b&gt;• Ethical Ingestion:&lt;/b&gt; Rate-limited public data access without login bypass&lt;br&gt;&lt;b&gt;• Automated Queue:&lt;/b&gt; Pushes batch discovered listings to backend&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="260" x="1270" y="215" as="geometry" />
        </mxCell>
        <mxCell id="postgres_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;verticalAlign=top;spacingTop=12;arcSize=4;" value="&lt;b style=&quot;font-size:18px;color:#065F46;&quot;&gt;PostgreSQL Unified Database&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px;color:#047857;font-weight:bold;&quot;&gt;[Central Vault for Laws, Slang, Deduplication &amp;amp; Audit Records]&lt;/span&gt;" vertex="1">
          <mxGeometry height="245" width="1540" x="40" y="580" as="geometry" />
        </mxCell>
        <mxCell id="db_c1" parent="postgres_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;" value="&lt;b style=&quot;font-size:13px;color:#065F46;&quot;&gt;1. Protected Species &amp;amp; Laws&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.55;&quot;&gt;&lt;b&gt;• Legal Protection List:&lt;/b&gt; Indian law (WPA 1972)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;amp; global treaties (CITES Appendices I–III)&lt;br&gt;&lt;b&gt;• Statutory Grounding:&lt;/b&gt; Defines which species&lt;br&gt;&amp;nbsp;&amp;nbsp;and body parts are illegal to trade&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="355" x="20" y="48" as="geometry" />
        </mxCell>
        <mxCell id="db_c2" parent="postgres_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;" value="&lt;b style=&quot;font-size:13px;color:#065F46;&quot;&gt;2. Poacher Slang Dictionary&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.55;&quot;&gt;&lt;b&gt;• Codeword Translation:&lt;/b&gt; Decodes secret slang&lt;br&gt;&amp;nbsp;&amp;nbsp;(e.g., &lt;i&gt;&quot;hathajodi&quot;&lt;/i&gt; → Bengal Monitor Lizard)&lt;br&gt;&lt;b&gt;• Vernacular Names:&lt;/b&gt; 45,000+ local animal&lt;br&gt;&amp;nbsp;&amp;nbsp;names mapped across 100 languages&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="355" x="395" y="48" as="geometry" />
        </mxCell>
        <mxCell id="db_c3" parent="postgres_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;" value="&lt;b style=&quot;font-size:13px;color:#065F46;&quot;&gt;3. Ad Memory &amp;amp; Deduplication&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.55;&quot;&gt;&lt;b&gt;• Content Fingerprints:&lt;/b&gt; SHA-256 hash of&lt;br&gt;&amp;nbsp;&amp;nbsp;every listing text and image&lt;br&gt;&lt;b&gt;• Instant Skip:&lt;/b&gt; Avoids re-scanning identical&lt;br&gt;&amp;nbsp;&amp;nbsp;ads discovered across multiple sites&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="355" x="770" y="48" as="geometry" />
        </mxCell>
        <mxCell id="db_c4" parent="postgres_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;" value="&lt;b style=&quot;font-size:13px;color:#065F46;&quot;&gt;4. Audit Logs &amp;amp; Case Files&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11.5px;line-height:1.55;&quot;&gt;&lt;b&gt;• Evidence Records:&lt;/b&gt; Stores scan timestamps,&lt;br&gt;&amp;nbsp;&amp;nbsp;AI suspicion scores &amp;amp; highlighted text&lt;br&gt;&lt;b&gt;• Case Queue:&lt;/b&gt; Officer queue to verify evidence&lt;br&gt;&amp;nbsp;&amp;nbsp;and export official reports for police&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="375" x="1145" y="48" as="geometry" />
        </mxCell>
        <mxCell id="db_privacy" parent="postgres_box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#10B981;strokeWidth=1;fontSize=12;fontColor=#065F46;fontStyle=1;align=center;" value="🔒 Privacy Guarantee: Zero seller personal data stored (no phone numbers, personal names, or handles)" vertex="1">
          <mxGeometry height="30" width="1500" x="20" y="198" as="geometry" />
        </mxCell>
        <mxCell id="flow_user" edge="1" parent="1" source="user_box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#64748B;fontColor=#475569;fontSize=11;" target="react_app" value="uses dashboard">
