        <mxCell id="flow_be_db_persist" edge="1" parent="1" source="backend_boundary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2.5;strokeColor=#059669;fontColor=#065F46;" target="postgres_box" value="&lt;span style=&quot;background-color:#059669;color:#FFFFFF;padding:1px 5px;border-radius:3px;font-weight:bold;font-size:10.5px;&quot;&gt;STEP 4&lt;/span&gt; &lt;b style=&quot;color:#059669;font-size:11.5px;&quot;&gt;Save Audit Record&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#065F46;&quot;&gt;INSERT scan log &amp;amp; case dossier&lt;/span&gt;">
