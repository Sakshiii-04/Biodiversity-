<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Antigravity">
  <diagram id="iwt-system-arch-v3" name="IWT Detection — System Architecture">
    <mxGraphModel dx="1502" dy="922" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- LEGEND BAR -->
        <mxCell id="legend_bar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=1.5;fontSize=13;fontColor=#9A3412;" value="&lt;b&gt;Core Principle:&lt;/b&gt; &lt;span style=&quot;color:#EA580C;font-weight:800;font-size:14px;&quot;&gt;AI flags. Human verifies. No automatic accusation.&lt;/span&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b style=&quot;color:#2563EB;&quot;&gt;Solid Lines:&lt;/b&gt; Requests &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b style=&quot;color:#0284C7;&quot;&gt;Dashed Lines:&lt;/b&gt; Responses &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b&gt;No PII stored&lt;/b&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;b&gt;Public data only&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="1000" x="300" y="92" as="geometry" />
        </mxCell>

        <!-- ===== LEFT: INVESTIGATOR ===== -->
        <mxCell id="user_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;" value="&lt;b style=&quot;font-size:16px;color:#1E293B;&quot;&gt;Wildlife Investigator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B;&quot;&gt;WCCB · NGO Analyst · Forest Dept&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="80" y="160" as="geometry" />
        </mxCell>

        <!-- ===== LEFT: REACT FRONTEND ===== -->
        <mxCell id="react_app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;spacingTop=12;arcSize=6;" value="&lt;b style=&quot;font-size:20px;color:rgb(29,78,216);&quot;&gt;React Frontend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:rgb(51,65,85);font-weight:600;&quot;&gt;React 19 + TypeScript · Vite 8 · Tailwind CSS v4&lt;/span&gt;&lt;div style=&quot;text-align:left;font-size:13px;line-height:1.6;padding-left:6px;&quot;&gt;&lt;br&gt;&lt;b&gt;• oxlint:&lt;/b&gt; strict TS linting&lt;br&gt;&lt;b&gt;• Three.js:&lt;/b&gt; 3D incident globe&lt;br&gt;&lt;b&gt;• Lucide React:&lt;/b&gt; icon system&lt;br&gt;&lt;b&gt;• Submission form:&lt;/b&gt; text / image / URL&lt;br&gt;&lt;b&gt;• Dossier viewer:&lt;/b&gt; case detail + export&lt;br&gt;&lt;br&gt;&lt;i style=&quot;color:#94A3B8;font-size:11px;&quot;&gt;Read-only: never touched by backend tasks&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="220" x="80" y="258" as="geometry" />
        </mxCell>

        <!-- ===== LEFT BOTTOM: POSTGRESQL ===== -->
        <mxCell id="postgres_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;verticalAlign=top;spacingTop=12;arcSize=6;" value="&lt;b style=&quot;font-size:19px;color:#065F46;&quot;&gt;PostgreSQL&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:13px;line-height:1.5;padding-left:6px;&quot;&gt;&lt;b&gt;• SHA-256 dedup index&lt;/b&gt;&lt;br&gt;&lt;b&gt;• AnalysisResult audit rows&lt;/b&gt;&lt;br&gt;&lt;b&gt;• Case management queue&lt;/b&gt;&lt;br&gt;&lt;b&gt;• Chain-of-custody log&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#94A3B8;font-size:11px;&quot;&gt;No seller PII ever stored&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="195" width="220" x="70" y="625" as="geometry" />
        </mxCell>

        <!-- ===== CENTRE: FASTAPI BACKEND (container) ===== -->
        <mxCell id="backend_boundary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;verticalAlign=top;spacingTop=14;arcSize=4;" value="&lt;b style=&quot;font-size:20px;color:#0369A1;&quot;&gt;FastAPI Backend&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:13px;color:#0284C7;font-weight:bold;&quot;&gt;[Python 3.11 · Docker on Render]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569;&quot;&gt;Lazy model loading · Stateless (Phase 2) · uv env · pytest + ruff quality gates&lt;/span&gt;" vertex="1">
          <mxGeometry height="700" width="540" x="490" y="160" as="geometry" />
        </mxCell>

        <!-- ===== ML ENGINES PANEL (child of backend) ===== -->
        <mxCell id="engines_panel" parent="backend_boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;verticalAlign=top;spacingTop=10;arcSize=6;" value="&lt;b style=&quot;font-size:17px;color:#9A3412;&quot;&gt;ML ENGINES PANEL&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px;color:#EA580C;font-weight:bold;&quot;&gt;[Core Innovation]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#7C2D12;&quot;&gt;Open-source · Runs on consumer GPU · Zero cloud AI dependency&lt;/span&gt;" vertex="1">
          <mxGeometry height="474" width="494" x="23" y="79" as="geometry" />
        </mxCell>

        <!-- XLM-RoBERTa (child of engines_panel) -->
        <mxCell id="engine_text" parent="engines_panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b style=&quot;font-size:13px;color:#1D4ED8;&quot;&gt;XLM-RoBERTa Text Classifier&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#64748B;&quot;&gt;facebook/xlm-roberta-base · fine-tuned on WLT-OSN&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;• Language support:&lt;/b&gt; 100+ languages&lt;br&gt;&lt;b&gt;• Detects:&lt;/b&gt; species names, codewords&lt;br&gt;&amp;nbsp;&amp;nbsp;(e.g. hathajodi → monitor lizard),&lt;br&gt;&amp;nbsp;&amp;nbsp;bulk trade signals, permit evasion,&lt;br&gt;&amp;nbsp;&amp;nbsp;private-messaging redirects&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#1D4ED8;&quot;&gt;Output → text_prob: float [0, 1]&lt;/b&gt;" vertex="1">
          <mxGeometry height="220" width="230" x="10" y="52" as="geometry" />
        </mxCell>

        <!-- CLIP / YOLOv8 (child of engines_panel) -->
        <mxCell id="engine_image" parent="engines_panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b style=&quot;font-size:13px;color:#5B21B6;&quot;&gt;CLIP / YOLOv8 Image Classifier&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#64748B;&quot;&gt;Phase 2: CLIP ViT-B/32 · Phase 3: YOLOv8&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;• CLIP:&lt;/b&gt; zero-shot species ID via&lt;br&gt;&amp;nbsp;&amp;nbsp;text query, no training images needed&lt;br&gt;&lt;b&gt;• YOLOv8:&lt;/b&gt; bounding-box detection&lt;br&gt;&amp;nbsp;&amp;nbsp;once image dataset is built (Ph 3)&lt;br&gt;&lt;b&gt;• Detects:&lt;/b&gt; protected species, animal&lt;br&gt;&amp;nbsp;&amp;nbsp;parts, shipping/packaging cues&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#5B21B6;&quot;&gt;Output → image_confidence: float [0, 1]&lt;/b&gt;" vertex="1">
          <mxGeometry height="220" width="244" x="250" y="52" as="geometry" />
        </mxCell>

        <!-- Bayesian Fusion (child of engines_panel) -->
        <mxCell id="engine_fusion" parent="engines_panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=12;fontColor=#1E293B;" value="&lt;b style=&quot;font-size:13px;color:#BE123C;&quot;&gt;Bayesian Fusion + Threshold Classification&lt;/b&gt;&lt;br&gt;&lt;br&gt;fused_score = &lt;b&gt;0.6 × text_prob&lt;/b&gt; + &lt;b&gt;0.4 × image_confidence&lt;/b&gt; &amp;nbsp;(text-only → text_prob; image-only → image_confidence)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#DC2626;&quot;&gt;● ≥ 0.75 → &lt;b&gt;SUSPECTED WILDLIFE TRADE&lt;/b&gt; · Critical&lt;/span&gt; &amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#D97706;&quot;&gt;● ≥ 0.50 → &lt;b&gt;SUSPECTED WILDLIFE TRADE&lt;/b&gt; · Elevated&lt;/span&gt; &amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#EA580C;&quot;&gt;● ≥ 0.30 → &lt;b&gt;REQUIRES MANUAL REVIEW&lt;/b&gt;&lt;/span&gt; &amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#16A34A;&quot;&gt;● &amp;lt; 0.30 → &lt;b&gt;NO EVIDENCE DETECTED&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="108" width="474" x="10" y="286" as="geometry" />
        </mxCell>

        <!-- CITES Grounding note (child of engines_panel) -->
        <mxCell id="engine_cites" parent="engines_panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1;fontSize=11.5;fontColor=#78350F;align=left;spacingLeft=10;" value="&lt;b&gt;CITES Appendix I / II / III lookup on every prediction&lt;/b&gt; · prevents hallucination · output schema-validated via Pydantic (AnalysisResult ↔ src/types/index.ts exact field match)" vertex="1">
          <mxGeometry height="50" width="474" x="10" y="408" as="geometry" />
        </mxCell>

        <!-- API Layer (child of backend) -->
        <mxCell id="api_layer" parent="backend_boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;fontSize=12;fontColor=#0C4A6E;align=left;spacingLeft=12;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;API Routes + Pydantic Validation&lt;/b&gt;&lt;br&gt;&lt;b&gt;POST /analyze&lt;/b&gt; (inputType: text | image | both) &amp;nbsp;|&amp;nbsp; &lt;b&gt;GET /health&lt;/b&gt; → {&quot;status&quot;: &quot;ok&quot;} &amp;nbsp;|&amp;nbsp; CORS · rate limiting · no JWT (stateless)" vertex="1">
          <mxGeometry height="62" width="494" x="23" y="569" as="geometry" />
        </mxCell>

        <!-- Output schema note (child of backend) -->
        <mxCell id="output_note" parent="backend_boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=1;fontSize=11.5;fontColor=#0C4A6E;align=left;spacingLeft=10;" value="&lt;b&gt;Returns AnalysisResult:&lt;/b&gt; inputType · confidence · detectedSpecies · riskLevel · indicators[ ] · explanation · isFlaggedForHumanReview · caseId" vertex="1">
          <mxGeometry height="38" width="494" x="23" y="645" as="geometry" />
        </mxCell>

        <!-- ===== RIGHT: CITES LEXICON ===== -->
        <mxCell id="ext_lexicon" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;verticalAlign=top;spacingTop=12;arcSize=6;" value="&lt;b style=&quot;font-size:17px;color:#14532D;&quot;&gt;CITES Lexicon&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:13px;line-height:1.5;padding-left:6px;&quot;&gt;&lt;b&gt;• Appendix I / II / III&lt;/b&gt; species list&lt;br&gt;&lt;b&gt;• 45,000+ common names&lt;/b&gt; · 100 langs&lt;br&gt;&lt;b&gt;• Hindi / Hinglish codewords&lt;/b&gt;&lt;br&gt;&lt;b&gt;• Alfino &amp;amp; Roberts ivory codewords&lt;/b&gt;&lt;br&gt;&lt;b&gt;• Stringham seizure taxa&lt;/b&gt; (4,900+)&lt;br&gt;&lt;br&gt;&lt;i style=&quot;color:#94A3B8;font-size:11px;&quot;&gt;data/lexicons/ — version-controlled&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="220" x="1140" y="160" as="geometry" />
        </mxCell>

        <!-- ===== RIGHT: TRAINING DATASETS ===== -->
        <mxCell id="ext_datasets" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;verticalAlign=top;spacingTop=12;arcSize=6;" value="&lt;b style=&quot;font-size:17px;color:#9A3412;&quot;&gt;Training Datasets&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:13px;line-height:1.5;padding-left:6px;&quot;&gt;&lt;b&gt;• WLT-OSN&lt;/b&gt; (Mou et al. 2024)&lt;br&gt;&amp;nbsp;&amp;nbsp;8,676 rows · 255 positive labels&lt;br&gt;&lt;b&gt;• Stringham 2021&lt;/b&gt; (PLOS ONE)&lt;br&gt;&amp;nbsp;&amp;nbsp;~16.5k labelled trade listings&lt;br&gt;&lt;b&gt;• Split:&lt;/b&gt; GroupShuffleSplit on source&lt;br&gt;&amp;nbsp;&amp;nbsp;(prevents label leakage)&lt;br&gt;&lt;br&gt;&lt;i style=&quot;color:#94A3B8;font-size:11px;&quot;&gt;Offline · Kaggle / Colab fine-tuning&lt;br&gt;Checkpoint → models/checkpoints/&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="220" x="1140" y="390" as="geometry" />
        </mxCell>

        <!-- ===== RIGHT: PLAYWRIGHT CRAWLER ===== -->
        <mxCell id="ext_crawler" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;strokeWidth=2;verticalAlign=top;spacingTop=12;arcSize=6;" value="&lt;b style=&quot;font-size:17px;color:#881337;&quot;&gt;Playwright Crawler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#BE123C;font-weight:bold;&quot;&gt;[Phase 3 — plug-in ready]&lt;/span&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;font-size:13px;line-height:1.5;padding-left:6px;&quot;&gt;&lt;b&gt;• Sources:&lt;/b&gt; OLX, Facebook Groups,&lt;br&gt;&amp;nbsp;&amp;nbsp;Telegram Channels, trade forums&lt;br&gt;&lt;b&gt;• Rate limit:&lt;/b&gt; 3 s / req · public only&lt;br&gt;&lt;b&gt;• Queue:&lt;/b&gt; Redis + BullMQ async&lt;br&gt;&lt;b&gt;• Pushes to:&lt;/b&gt; POST /ingest&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="220" x="1140" y="640" as="geometry" />
        </mxCell>

        <!-- ===== FLOW ARROWS ===== -->

        <!-- Step 1: Investigator → React App (uses) -->
        <mxCell id="flow0" edge="1" parent="1" source="user_box" target="react_app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#94A3B8;fontColor=#475569;fontSize=11;" value="uses">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 2a: React App → Backend (POST /analyze) -->
        <mxCell id="flow2" edge="1" parent="1" source="react_app" target="backend_boundary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2563EB;fontColor=#1D4ED8;" value="&lt;b style=&quot;color:#2563EB;font-size:12px;&quot;&gt;[Step 2a] POST /analyze&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;inputType · text · base64_image&lt;/span&gt;">
          <mxGeometry relative="1" y="-12" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Step 2b: Backend → React App (AnalysisResult, dashed) -->
        <mxCell id="flow2_resp" edge="1" parent="1" source="backend_boundary" target="react_app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0284C7;strokeDasharray=5 3;fontColor=#0369A1;" value="&lt;b style=&quot;color:#0369A1;font-size:12px;&quot;&gt;[Step 2b] AnalysisResult JSON&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;confidence · verdict · indicators[ ]&lt;/span&gt;">
          <mxGeometry relative="1" y="18" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="400" y="420" />
              <mxPoint x="400" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 3a: Backend → CITES Lexicon -->
        <mxCell id="flow3" edge="1" parent="1" source="backend_boundary" target="ext_lexicon" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;fontColor=#15803D;" value="&lt;b style=&quot;color:#15803D;font-size:12px;&quot;&gt;[Step 3a] Species lookup&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;raw token · codeword resolution&lt;/span&gt;">
          <mxGeometry relative="1" y="-12" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="1120" y="265" />
              <mxPoint x="1120" y="265" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 3b: CITES Lexicon → Backend (dashed) -->
        <mxCell id="flow3_resp" edge="1" parent="1" source="ext_lexicon" target="backend_boundary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;strokeDasharray=5 3;fontColor=#15803D;" value="&lt;b style=&quot;color:#15803D;font-size:12px;&quot;&gt;[Step 3b] Resolved species&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Appendix status · trade indicators&lt;/span&gt;">
          <mxGeometry relative="1" y="12" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="1120" y="305" />
              <mxPoint x="1120" y="305" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 4a: Backend → PostgreSQL (persist) -->
        <mxCell id="flow4" edge="1" parent="1" source="backend_boundary" target="postgres_box" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#059669;fontColor=#065F46;" value="&lt;b style=&quot;color:#059669;font-size:12px;&quot;&gt;[Step 4a] Persist audit log&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;SHA-256 · verdict · case_id&lt;/span&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="710" />
              <mxPoint x="380" y="710" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 4b: PostgreSQL → Backend (confirmed, dashed) -->
        <mxCell id="flow4_resp" edge="1" parent="1" source="postgres_box" target="backend_boundary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#059669;strokeDasharray=5 3;fontColor=#065F46;" value="&lt;b style=&quot;color:#059669;font-size:12px;&quot;&gt;[Step 4b] case_id confirmed&lt;/b&gt;">
          <mxGeometry relative="1" y="12" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="350" y="740" />
              <mxPoint x="350" y="740" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Offline: Training Datasets → Backend (dashed, italic) -->
        <mxCell id="flow_train" edge="1" parent="1" source="ext_datasets" target="backend_boundary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.8;strokeColor=#F97316;strokeDasharray=6 4;fontColor=#9A3412;fontSize=11;fontStyle=2;" value="&lt;i&gt;Offline fine-tuning&lt;br&gt;checkpoint → models/checkpoints/&lt;/i&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1120" y="505" />
              <mxPoint x="1120" y="505" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Phase 3: Crawler → Backend -->
        <mxCell id="flow_crawl" edge="1" parent="1" source="ext_crawler" target="backend_boundary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#F43F5E;fontColor=#881337;" value="&lt;b style=&quot;color:#BE123C;font-size:12px;&quot;&gt;[Phase 3] POST /ingest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;raw listing text + image_url&lt;/span&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1120" y="740" />
              <mxPoint x="1120" y="740" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- FOOTER -->
        <mxCell id="footer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=none;fontSize=11;fontStyle=1;fontColor=#E2E8F0;" value="🌿 SDG 15 — Life on Land &amp;nbsp;|&amp;nbsp; ⚖️ SDG 16 — Peace &amp;amp; Justice &amp;nbsp;|&amp;nbsp; India-first · 100+ languages · Open-source · Free for NGOs &amp;amp; Forest Depts &amp;nbsp;|&amp;nbsp; Acropolis Institute of Technology &amp;amp; Research, Indore · SUSTAINOVA 2026" vertex="1">
          <mxGeometry x="20" y="878" width="1560" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
